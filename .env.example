# Скопируйте в .env и подставьте свои значения: cp .env.example .env
GREETING="ваше приветствие"
POSTGRES_PASSWORD="придумайте_пароль"
# Для локального запуска без Docker (в Compose адрес задан в compose.yaml)
DOCKER_DATABASE_URL="postgresql://appuser:${POSTGRES_PASSWORD}@db:5432/appdb"

# Образ в реестре ghcr.io (логин и имя репозитория строчными) и версия для выката
GHCR_IMAGE="ghcr.io/your-login/guestbook-workshop"
APP_VERSION="v1.0.0"